# Environment variables for Cafeteria Management backend
# Copy this file to .env and fill in your actual values

SECRET_KEY=your-very-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Local PostgreSQL (used when DATABASE_URL is not set) ---
DB_NAME=cafeteria_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Production / Render (set this in Render environment variables) ---
# DATABASE_URL=postgres://user:password@host:port/dbname

# Security / CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com

# Optional local/demo helper. Leave disabled in production.
# CREATE_DEMO_USERS=true
