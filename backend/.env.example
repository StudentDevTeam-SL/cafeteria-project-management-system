# Environment variables for Cafeteria Management backend
# Copy this file to .env and fill in your actual values

SECRET_KEY=your-very-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Local PostgreSQL (used when DATABASE_URL is not set) ---
DB_NAME=cafeteria_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Production / Vercel (set these in your Vercel Project Environment Variables) ---
# DATABASE_URL=<Neon or Supabase Postgres connection string>
# SECRET_KEY=<strong random secret>
# DEBUG=False
# ALLOWED_HOSTS=cafeteria-systemchi.vercel.app,.vercel.app
# CORS_ALLOWED_ORIGINS=https://cafeteria-systemchi.vercel.app
# CSRF_TRUSTED_ORIGINS=https://cafeteria-systemchi.vercel.app
# BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
# BLOB_ACCESS=private

# --- Redis/Upstash Cache (Optional local, recommended for production/Vercel) ---
# Format: rediss://default:<password>@<host>:<port>
# REDIS_URL=rediss://default:yourpassword@yourhost.upstash.io:6379

# Optional local/demo helper. Leave disabled in production.
# CREATE_DEMO_USERS=true
