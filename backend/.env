SECRET_KEY=django-insecure-cafeteria-secret-key-123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Local PostgreSQL (used when DATABASE_URL is not set) ---
